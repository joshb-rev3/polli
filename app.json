{
  "expo": {
    "name": "Polli",
    "slug": "polli",
    "scheme": "polli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#1B4D3E",
    "description": "Share Just $1 and Spread Endless Good. Start a Polli for someone you appreciate, kick it off with a dollar, and watch friends spread the love.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rev3labs.polli",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:polli-app.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Polli uses the microphone so you can record a voice message for your Polli.",
        "CFBundleDisplayName": "Polli"
      }
    },
    "android": {
      "package": "com.rev3labs.polli",
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBF5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "polli-app.com" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Polli",
      "shortName": "Polli",
      "description": "Share Just $1 and Spread Endless Good",
      "themeColor": "#1B4D3E",
      "backgroundColor": "#FFFBF5",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-av",
        {
          "microphonePermission": "Polli uses the microphone so you can record a voice message for your recipient."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.rev3labs.polli",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "siteUrl": "https://polli-app.com"
    }
  }
}
